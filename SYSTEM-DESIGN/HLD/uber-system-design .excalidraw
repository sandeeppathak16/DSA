      "isDeleted": true,
      "boundElements": [],
      "updated": 1787297709850,
      "link": null,
      "locked": false,
      "text": "Layer 4 Load Balancer\n\n    Layer 4 operates at the Transport Layer.\n\n    It works with information such as:\n\n        Source IP\n        Destination IP\n        TCP Port\n        UDP Port",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Layer 4 Load Balancer\n\n    Layer 4 operates at the Transport Layer.\n\n    It works with information such as:\n\n        Source IP\n        Destination IP\n        TCP Port\n        UDP Port",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "efmZJZ2UjP2H82yyBCBxK",
      "type": "text",
      "x": 416.4024261151827,
      "y": 13143.239001788112,
      "width": 622.4705810546875,
      "height": 420,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bDH",
      "roundness": null,
      "seed": 289258671,
      "version": 8,
      "versionNonce": 1083757244,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1787297709850,
      "link": null,
      "locked": false,
      "text": "Layer 7 Load Balancer\n\n    Layer 7 operates at the Application Layer.\n\n    It understands HTTP requests.\n\n        It can inspect:\n        \n        URLs\n        Headers\n        Cookies\n        Request Methods",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Layer 7 Load Balancer\n\n    Layer 7 operates at the Application Layer.\n\n    It understands HTTP requests.\n\n        It can inspect:\n        \n        URLs\n        Headers\n        Cookies\n        Request Methods",
      "autoResize": true,
      "lineHeight": 1.25
    },
