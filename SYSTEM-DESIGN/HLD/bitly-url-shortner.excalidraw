    {
      "id": "ZSGzqnQrdJVOpGMfKBt2t",
      "type": "text",
      "x": 1023.2669188402756,
      "y": 17839.311217305083,
      "width": 646.5225830078125,
      "height": 385,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bHC",
      "roundness": null,
      "seed": 194117506,
      "version": 316,
      "versionNonce": 1174974750,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788344803470,
      "link": null,
      "locked": false,
      "text": "1. prefix the long url\n2. random number generator 10^9 10 characters\n    - base62 encoding, \n    - 62^6 = 56B\n3. hash the long url\n    - md5(longurl) -> hash -> base62(hash) \n\n4. counter \n    - increase counter -> base62(counter) \n    - predictability which is bad for sequirty  \n",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. prefix the long url\n2. random number generator 10^9 10 characters\n    - base62 encoding, \n    - 62^6 = 56B\n3. hash the long url\n    - md5(longurl) -> hash -> base62(hash) \n\n4. counter \n    - increase counter -> base62(counter) \n    - predictability which is bad for sequirty  \n",
      "autoResize": true,
      "lineHeight": 1.25
    },
